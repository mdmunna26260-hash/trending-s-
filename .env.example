# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# PostgreSQL connection string. In development the bundled script starts a
# local embedded PostgreSQL on port 5432 automatically.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/trending_s?schema=public"

# 32+ byte random string used for HMAC signed session / tracking tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-64-byte-random-secret"

# Canonical storefront URL used in emails, coupons and tracking events.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Extra origins the dev server may serve /_next/* assets to, comma separated.
# Only needed when previewing through a proxy domain (e.g. "*.e2b.app"); leave
# as-is for plain localhost development.
NEXT_DEV_ORIGINS="*.e2b.app,localhost,127.0.0.1"

# ---------------------------------------------------------------------------
# Admin bootstrap (used once by the seed script)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="mdmunna26260@gmail.com"
ADMIN_PASSWORD="KissmeBabu64"
ADMIN_NAME="Store Owner"

# ---------------------------------------------------------------------------
# Steadfast courier API (https://docs.steadfast.com.bd)
# ---------------------------------------------------------------------------
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"

# ---------------------------------------------------------------------------
# Fraud providers (optional, leave empty to disable)
# ---------------------------------------------------------------------------
FRAUD_API_URL=""
FRAUD_API_KEY=""
FRAUDBD_API_KEY=""

# ---------------------------------------------------------------------------
# Gmail SMTP (use an App Password, never your login password)
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RUVIO <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Marketing / tracking
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
META_CONVERSIONS_API_TOKEN=""
META_TEST_EVENT_CODE=""

# ---------------------------------------------------------------------------
# Optional SMS OTP provider for phone login (leave empty to disable)
# ---------------------------------------------------------------------------
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
